+}
+
+macro_rules! make_bool_atomic {
+    ($at_ident:ident, $rust_ty: ty, $value_ty: ty) => {
+        atomic_types!($at_ident, $rust_ty, $value_ty);
+        #[cfg_attr(verus_keep_ghost, verus::internal(verus_macro))]
+        impl $at_ident {
