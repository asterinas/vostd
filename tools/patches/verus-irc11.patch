+        #[verifier::atomic]
+        pub fn store(
+            &self,
+            v: $value_ty,
+            order: Ordering,
+            Tracked(vs): Tracked<&mut ViewSeen>,
+            Tracked(rel_vs): Tracked<ReleaseViewSeen>,
+            Tracked(pt): Tracked<&mut AtomicPointsTo<$value_ty>>,
+        ) -> (st: (Ghost<StoreData>))
